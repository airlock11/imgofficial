{
  "version": 1,
  "policy": {
    "publishVerifiedOnly": true,
    "preserveLastValidOnFailure": true,
    "neverMixLeagues": true,
    "liveStatusMustBeVerified": true,
    "highlightsOnlyWhenLegitimateSourceExists": true
  },
  "dimensions": [
    "scores",
    "schedule",
    "statistics",
    "rankings",
    "standings",
    "liveStreams",
    "highlights"
  ],
  "pipelines": {
    "direct_espn": {
      "description": "Browser/API score feed with in-place auto refresh",
      "freshMinutes": 1
    },
    "extended": {
      "description": "Official/verified web and API collector",
      "freshMinutes": 10
    },
    "regional": {
      "description": "Regional league official web collector",
      "freshMinutes": 20
    },
    "stats": {
      "description": "Statistics/leader collector",
      "freshMinutes": 20
    },
    "sportradar": {
      "description": "Quota-limited soccer enrichment collector",
      "freshMinutes": 300
    },
    "youtube": {
      "description": "Verified official live-stream scanner",
      "freshMinutes": 10
    },
